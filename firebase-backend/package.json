{
  "name": "klatchup-firebase-backend",
  "version": "1.0.0",
  "description": "Klatchup backend using Firebase Functions and Firestore",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && firebase emulators:start",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "npx ts-node src/seed-users.ts",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,
    
    "chatrooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        
        "messages": {
          "$messageId": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['text', 'sender', 'timestamp']) && newData.child('text').isString() && newData.child('sender').isString()"
          }
        },
        
        "participants": {
          "$userId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $userId"
          }
        },
        
        "metadata": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId",
        
        "presence": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    }
  }
}
